From 3a7cc07517b154f5d4bb50a6edbb48c2a78ddc4c Mon Sep 17 00:00:00 2001
From: George Garside <apps@georgegarside.com>
Date: Sat, 22 Nov 2025 17:48:22 +0000
Subject: [PATCH 2/2] Show notes for categories in list view

---
 app/Repositories/Category/CategoryRepository.php      | 2 +-
 resources/views/components/lists/categories.blade.php | 5 ++++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/app/Repositories/Category/CategoryRepository.php b/app/Repositories/Category/CategoryRepository.php
index 70f9ed0d23..fcb508e929 100644
--- a/app/Repositories/Category/CategoryRepository.php
+++ b/app/Repositories/Category/CategoryRepository.php
@@ -188,7 +188,7 @@ public function getByIds(array $categoryIds): Collection
      */
     public function getCategories(): Collection
     {
-        return $this->user->categories()->with(['attachments'])->orderBy('name', 'ASC')->get();
+        return $this->user->categories()->with(['attachments', 'notes'])->orderBy('name', 'ASC')->get();
     }
 
     public function getNoteText(Category $category): ?string
diff --git a/resources/views/components/lists/categories.blade.php b/resources/views/components/lists/categories.blade.php
index e3590d742f..54a1c0df51 100644
--- a/resources/views/components/lists/categories.blade.php
+++ b/resources/views/components/lists/categories.blade.php
@@ -17,11 +17,14 @@
     </tr>
     @foreach($categories as $category)
     <tr>
-        <td data-value="{{ $category->name }}">
+        <td class="markdown" data-value="{{ $category->name }}">
             <a href="{{ route('categories.show', [$category->id]) }}" title="{{ $category->name }}">{{ $category->name }}</a>
             @if($category->attachments->count() > 0)
                 <span class="bi bi-paperclip"></span>
             @endif
+            @if($category->notes->count() > 0)
+                <small><br/>{!! parse_markdown($category->notes->first()->text) !!}</small>
+            @endif
         </td>
         @if(null !== $category->lastActivity)
         <td data-value="{{ $category->lastActivity->format('Y-m-d H-i-s') }}">
-- 
2.55.0

