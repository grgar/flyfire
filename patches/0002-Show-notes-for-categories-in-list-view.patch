From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: George Garside <apps@georgegarside.com>
Date: Sat, 22 Nov 2025 17:48:22 +0000
Subject: [PATCH] Show notes for categories in list view

The index is now an Alpine page fed by the API, so add the notes from the view.
---
diff --git a/resources/views/categories/index.blade.php b/resources/views/categories/index.blade.php
index 57d75c8..1980637 100644
--- a/resources/views/categories/index.blade.php
+++ b/resources/views/categories/index.blade.php
@@ -104,4 +104,23 @@
 
 @section('scripts')
     @vite(['js/pages/categories/index.js'])
+    <script nonce="{{ $JS_NONCE }}">
+        // The rows are rendered client-side from the API, so add each category's notes once they appear.
+        const categoryNotes = @json(auth()->user()->categories()->with('notes')->get()->filter(fn ($c) => $c->notes->count() > 0)->mapWithKeys(fn ($c) => [$c->id => parse_markdown($c->notes->first()->text)]));
+        const addCategoryNotes = () => {
+            document.querySelectorAll('#category-index a[href*="/categories/show/"]').forEach((link) => {
+                const cell = link.closest('td');
+                const html = categoryNotes[link.getAttribute('href').split('/').pop()];
+                if (!html || !cell || cell.querySelector('.category-notes')) {
+                    return;
+                }
+                const notes = document.createElement('small');
+                notes.className = 'category-notes markdown d-block';
+                notes.innerHTML = html;
+                cell.appendChild(notes);
+            });
+        };
+        new MutationObserver(addCategoryNotes).observe(document.body, {childList: true, subtree: true});
+        addCategoryNotes();
+    </script>
 @endsection
