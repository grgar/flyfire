Subject: [PATCH 1/2] ALLOWED_HOSTS

---
 app/Http/Middleware/AllowedHosts.php | 23 +++++++++++++++++++++++
 bootstrap/app.php                    |  2 ++
 config/firefly.php                   |  1 +
 3 files changed, 26 insertions(+)
 create mode 100644 app/Http/Middleware/AllowedHosts.php

diff --git a/app/Http/Middleware/AllowedHosts.php b/app/Http/Middleware/AllowedHosts.php
new file mode 100644
index 0000000000..33e5dc70e4
--- /dev/null
+++ b/app/Http/Middleware/AllowedHosts.php
@@ -0,0 +1,23 @@
+<?php
+
+namespace FireflyIII\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+
+class AllowedHosts {
+    public function handle(Request $request, Closure $next) {
+        $allowedHosts = array_filter(array_map('trim', explode(',', (string) config('firefly.allowed_hosts'))));
+        if ([] === $allowedHosts) {
+            return $next($request);
+        }
+        $host = (string) $request->header('Host');
+        foreach ($allowedHosts as $allowedHost) {
+            if (str_starts_with($host, $allowedHost)) {
+                return $next($request);
+            }
+        }
+        app('log')->warning('Host not in ALLOWED_HOSTS: ' . $host);
+        abort(403);
+    }
+}
